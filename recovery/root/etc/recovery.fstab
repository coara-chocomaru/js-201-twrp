# Copyright (C) 2015 The Team Win Recovery Project
#
# TWRP fstab for Qualcomm MSM Android 5.1
# Based on gpt_main0.bin partition layout (43 partitions + GPT)
#
# Format: <device>  <mount point>  <fstype>  <options>  [twrp_flags]
# ----------------------------------------------------------------------
/dev/block/bootdevice/by-name/modem        /modem       emmc    defaults    flags=display="Modem",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/sbl1         /sbl1        emmc    defaults    flags=display="SBL1",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/sbl1bak      /sbl1bak     emmc    defaults    flags=display="SBL1 Backup",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/tz           /tz          emmc    defaults    flags=display="TrustZone",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/tzbak        /tzbak       emmc    defaults    flags=display="TrustZone Backup",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/rpm          /rpm         emmc    defaults    flags=display="RPM",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/rpmbak       /rpmbak      emmc    defaults    flags=display="RPM Backup",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/hyp          /hyp         emmc    defaults    flags=display="Hypervisor",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/hypbak       /hypbak      emmc    defaults    flags=display="Hypervisor Backup",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/aboot        /aboot       emmc    defaults    flags=display="Aboot",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/abootbak     /abootbak    emmc    defaults    flags=display="Aboot Backup",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/boot         /boot        emmc    defaults    flags=display="Boot",backup=1
/dev/block/bootdevice/by-name/recovery     /recovery    emmc    defaults    flags=display="Recovery",backup=1
/dev/block/bootdevice/by-name/fota         /fota        emmc    defaults    flags=display="FOTA",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/fotabk       /fotabk      emmc    defaults    flags=display="FOTA Backup",backup=1,canbewiped=0,wipeingui=0

/dev/block/bootdevice/by-name/persist      /persist     ext4    nosuid,nodev,barrier=1    flags=display="Persist",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/modemst1     /modemst1    emmc    defaults    flags=display="Modem ST1",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/modemst2     /modemst2    emmc    defaults    flags=display="Modem ST2",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/fsg          /fsg         emmc    defaults    flags=display="FSG",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/fsc          /fsc         emmc    defaults    flags=display="FSC",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/ssd          /ssd         emmc    defaults    flags=display="SSD",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/DDR          /DDR         emmc    defaults    flags=display="DDR",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/keystore     /keystore    emmc    defaults    flags=display="Keystore",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/config       /config      emmc    defaults    flags=display="Config",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/devinfo      /devinfo     emmc    defaults    flags=display="Devinfo",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/sec          /sec         emmc    defaults    flags=display="Sec",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/misc         /misc        emmc    defaults    flags=display="Misc",backup=1,canbewiped=0,wipeingui=0
/dev/block/bootdevice/by-name/splash       /splash      emmc    defaults    flags=display="Splash",backup=1,canbewiped=0,wipeingui=0

/dev/block/bootdevice/by-name/system       /system      ext4    ro,barrier=1                flags=display="System",backup=1,wipeingui=1
/dev/block/bootdevice/by-name/userdata     /data        ext4    nosuid,nodev,barrier=1,noauto_da_alloc    flags=display="Data",backup=1,wipeingui=1,encryptable=footer
/dev/block/bootdevice/by-name/cache        /cache       ext4    nosuid,nodev,barrier=1      flags=display="Cache",backup=1,wipeingui=1
/dev/block/bootdevice/by-name/oem          /oem         ext4    ro,barrier=1                flags=display="OEM",backup=1,wipeingui=1

/dev/block/mmcblk1p1                       /external_sd vfat    defaults    flags=display="MicroSD",storage;removable
