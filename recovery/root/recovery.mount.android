#<src>                                            <mnt_point>  <type>  <mnt_flags and options>  <fs_mgr_flags>

# When device boots as Android-mode, it mounts system image of zemi-mode to "/dmysys" instead of "/system".
# This mount point is necessary in order to refer information(such as build.prop) inside non-current system image.
/dev/block/bootdevice/by-name/system_zemi         /system2      ext4    ro,barrier=1,discard                                            wait
